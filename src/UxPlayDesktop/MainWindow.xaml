<Window x:Class="UxPlayDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
        xmlns:models="clr-namespace:UxPlayDesktop.Models"
        mc:Ignorable="d"
        Title="UxPlay Desktop - AirPlay Mirroring"
        Icon="resources/newicon.ico"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Status Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📺" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UxPlay Desktop" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,10,0" />
                            <Border Background="#2B3A4A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Windows AirPlay" FontSize="11" Foreground="#6EA8FE" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <!-- Status subtitle with colored dot -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
                            <TextBlock Text="{Binding StatusTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Start / Stop Button -->
                <Button Grid.Column="1"
                        Command="{Binding ToggleServerCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StartStopButtonIcon}" Margin="0,0,8,0" FontSize="14" />
                        <TextBlock Text="{Binding StartStopButtonText}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,12,16,12">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0" Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- UPDATE AVAILABLE BANNER (If Active) -->
                        <Border Style="{StaticResource CardStyle}"
                                Background="#1A334D"
                                BorderBrush="#2196F3"
                                Margin="0,0,0,16"
                                Visibility="{Binding IsUpdateAvailable, Converter={x:Static models:ObjectToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀 Nueva actualización disponible: " FontWeight="Bold" FontSize="14" Foreground="#90CAF9" />
                                        <TextBlock Text="{Binding UpdateVersionText}" FontWeight="Bold" FontSize="14" Foreground="White" />
                                    </StackPanel>
                                    <TextBlock Text="Se han incluido nuevas mejoras. Pulsa actualizar para aplicarla automáticamente en un clic." Foreground="#E3F2FD" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Actualizar ahora" Command="{Binding ApplyUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="Más tarde" Command="{Binding DismissUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PIN CODE PROMPT (If Active) -->
                        <Border Style="{StaticResource CardStyle}"
                                Background="#332B00"
                                BorderBrush="#FFC107"
                                Margin="0,0,0,16"
                                Visibility="{Binding ActivePinCode, Converter={x:Static models:ObjectToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔐 AirPlay Pairing PIN Requested" FontWeight="Bold" FontSize="15" Foreground="#FFD54F" />
                                    <TextBlock Text="Enter the following 4-digit code on your Apple device to authorize connection:" Foreground="#FFF9C4" Margin="0,4,0,8" />
                                    <TextBlock Text="{Binding ActivePinCode}" FontSize="36" FontWeight="Bold" Foreground="#FFE082" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissPinCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- ACTIVE STREAM & DEVICE HUD -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="Live Stream Metrics" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <Border Background="#1A3320" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ACTIVE HUD" FontSize="10" Foreground="#25D366" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Device Name -->
                                    <Border Grid.Column="0" Background="#1D1D1D" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="CONNECTED DEVICE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Session.ClientName, TargetNullValue='No Device'}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Session.ClientIpAddress, TargetNullValue='Waiting...'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Resolution -->
                                    <Border Grid.Column="1" Background="#1D1D1D" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="RESOLUTION" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Session.ActiveResolution}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                            <TextBlock Text="Hardware Direct3D" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Codec & FPS -->
                                    <Border Grid.Column="2" Background="#1D1D1D" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="FORMAT &amp; FPS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Session.ActiveCodec}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Settings.TargetFps, StringFormat='Target: {0} FPS'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Duration -->
                                    <Border Grid.Column="3" Background="#1D1D1D" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="STREAM TIME" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FormattedDuration}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                            <TextBlock Text="Live Session" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- DISCORD & OBS STREAMING CARD -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Background="#202225" BorderBrush="#5865F2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="💬 Discord &amp; OBS Streaming Helper" FontSize="14" FontWeight="Bold" Foreground="#5865F2" />
                                        <Border Background="#5865F2" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="RECOMMENDED FOR TEACHING" FontSize="9" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Easily share your iPad notes, whiteboard, or slides in Discord voice channels or OBS Studio." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock Text="Window title is set to your server name for instant discovery in Discord's 'Screens &amp; Windows' picker." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding CopyDiscordStreamNameCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Copy Window Name"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- STREAMING PRESET SELECTOR -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Streaming Profile &amp; Performance Preset" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                <TextBlock Text="Select the profile best suited for your current task. No technical jargon required." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />

                                <ComboBox ItemsSource="{Binding AvailablePresets}"
                                          SelectedItem="{Binding SelectedPreset}"
                                          Margin="0,0,0,10">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static models:PresetDisplayConverter.Instance}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="#1C1C1C" CornerRadius="6" Padding="12">
                                    <TextBlock Text="{Binding PresetDescription}" Foreground="#C5C5C5" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- DISCOVERY & BONJOUR STATUS -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Device Discovery &amp; Network Status" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Service Status: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding BonjourStatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="Apple devices locate UxPlay on your Wi-Fi via mDNS and Bluetooth Low Energy beacon." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding FixBonjourCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Verify Bonjour"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: SETTINGS -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- General Settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="General Configuration" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                <TextBlock Text="AirPlay Server Display Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Settings.ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <CheckBox Content="Start UxPlay Desktop on Windows login" IsChecked="{Binding Settings.StartOnBoot}" Margin="0,0,0,8" />
                                <CheckBox Content="Minimize to System Tray on close" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,0,8" />
                                <CheckBox Content="Automatically start AirPlay server when application opens" IsChecked="{Binding Settings.AutoStartServer}" Margin="0,0,0,8" />
                                <CheckBox Content="Inhibit sleep and screensaver while presenting or mirroring" IsChecked="{Binding Settings.InhibitSleepAndScreensaver}" Margin="0,0,0,8" />
                                <CheckBox Content="Enable Bluetooth Low Energy (BLE) beacon for instant Apple discovery" IsChecked="{Binding Settings.EnableBluetoothBeacon}" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Video Settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Display &amp; Video Quality" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Target Resolution Width" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Settings.DisplayWidth}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Target Resolution Height" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Settings.DisplayHeight}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Target Framerate (FPS)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Settings.TargetFps}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Direct3D Video Sink" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Settings.VideoSink}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Enable H.265 / HEVC hardware decoding" IsChecked="{Binding Settings.EnableH265}" Margin="0,0,0,8" />
                                <CheckBox Content="Force Fullscreen display mode (Alt+Enter toggles)" IsChecked="{Binding Settings.ForceFullscreen}" Margin="0,0,0,8" />
                                <CheckBox Content="Borderless window mode (Optimized for Discord &amp; OBS capture)" IsChecked="{Binding Settings.BorderlessWindow}" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Security & Pairing -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Security &amp; PIN Pairing" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                <CheckBox Content="Require PIN authentication for client connections" IsChecked="{Binding Settings.RequirePin}" Margin="0,0,0,10" />

                                <TextBlock Text="Fixed 4-Digit PIN Code (Leave blank for random security PIN):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Settings.FixedPin}" MaxLength="4" Margin="0,0,0,12" />

                                <TextBlock Text="Optional Password (Optional legacy AirPlay password):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Settings.Password}" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Audio Settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Audio &amp; Synchronization Calibration" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                <CheckBox Content="Enable AirPlay audio playback" IsChecked="{Binding Settings.EnableAudio}" Margin="0,0,0,10" />

                                <TextBlock Text="{Binding Settings.AudioDelayMs, StringFormat='Audio Sync Delay: {0} ms'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Slider Minimum="-500" Maximum="500" Value="{Binding Settings.AudioDelayMs}" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,0,0,8" />
                                <TextBlock Text="Adjust positive or negative milliseconds to compensate for Bluetooth speaker or headphone latency." Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Save Button -->
                        <Button Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="💾 Save Settings"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: REAL-TIME LOGS -->
            <TabItem Header="Real-time Logs">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Toolbar -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Filter -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding Logs.SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Type to filter log messages..."
                                     Margin="0,0,10,0" />

                            <Button Grid.Column="1"
                                    Command="{Binding Logs.CopyLogsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="📋 Copy All"
                                    Margin="0,0,8,0" />

                            <Button Grid.Column="2"
                                    Command="{Binding Logs.ClearLogsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="🗑 Clear" />
                        </Grid>
                    </Border>

                    <!-- Logs List -->
                    <Border Grid.Row="1" Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ListView ItemsSource="{Binding Logs.Logs}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="White"
                                  FontFamily="Consolas, Cascadia Code, Courier New"
                                  FontSize="12">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" Foreground="#777777" />
                                        <Border Grid.Column="1" Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: ABOUT -->
            <TabItem Header="About">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="UxPlay Desktop for Windows" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                        <TextBlock Text="Modern, reliable, and user-friendly AirPlay screen mirroring desktop application." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,16" />

                        <TextBlock Text="Created for educators, online streamers, and presentation hosts to deliver seamless iPad / iPhone screen mirroring to Windows PCs with zero technical friction." Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <TextBlock Text="Engine &amp; Core Architecture:" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                        <TextBlock Text="• Upstream FDH2/UxPlay master core with modern iPadOS handshake reliability" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• Hardware-accelerated Direct3D 11/12 video rendering via GStreamer" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• Automatic keyframe synchronization &amp; deferred state transitions" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• Windows power request display inhibitor to prevent sleep during lectures" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="Repository &amp; License:" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                        <TextBlock Text="GitHub: https://github.com/jorjanion/uxplay-desktop" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="License: GNU General Public License v3.0 (GPL-3.0)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Background="#1D1D1D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusDescription}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="UxPlay Desktop v1.0.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
