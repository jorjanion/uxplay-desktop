<Window x:Class="UxPlayDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
        xmlns:models="clr-namespace:UxPlayDesktop.Models"
        mc:Ignorable="d"
        Title="UxPlay Desktop - AirPlay Mirroring"
        Icon="resources/newicon.ico"
        Height="{Binding WindowHeight, Mode=TwoWay}" Width="{Binding WindowWidth, Mode=TwoWay}"
        MinHeight="{Binding WindowMinHeight}" MinWidth="{Binding WindowMinWidth}"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- ============================================================== -->
        <!-- VIEW 1: NORMAL FULL WINDOW                                     -->
        <!-- ============================================================== -->
        <Grid Visibility="{Binding IsCompactMode, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER BAR -->
            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Status Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📺" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="UxPlay Desktop" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,10,0" />
                                <Border Background="#2B3A4A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Loc[WindowsAirPlay]}" FontSize="11" Foreground="#6EA8FE" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <!-- Status subtitle with colored dot -->
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
                                <TextBlock Text="{Binding StatusTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="•" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding StatusSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip="{Binding StatusDescription}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Controls in Header -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Screenshot -->
                        <Button Command="{Binding CaptureScreenshotCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Captura de pantalla instantánea [Ctrl+Shift+C]"
                                Margin="0,0,6,0"
                                Padding="10,8">
                            <TextBlock Text="📸" FontSize="13" />
                        </Button>

                        <!-- Quick Record Session -->
                        <Button Command="{Binding ToggleRecordingCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="{Binding Loc[RecordingTitle]}"
                                Margin="0,0,6,0"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsRecording, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />
                                <TextBlock Text="🎥 " FontSize="12" />
                                <TextBlock Text="{Binding RecordButtonText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Mini Widget Mode Toggle -->
                        <Button Command="{Binding ToggleCompactModeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="{Binding Loc[CompactModeLabel]}"
                                Margin="0,0,10,0"
                                Padding="10,8">
                            <TextBlock Text="🗗" FontSize="13" />
                        </Button>

                        <!-- Language Selector -->
                        <ComboBox ItemsSource="{Binding Loc.SupportedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Width="150"
                                  Height="36"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Flag}" Margin="0,0,6,0" FontSize="14" />
                                        <TextBlock Text="{Binding NativeName}" Foreground="White" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Start / Stop Button -->
                        <Button Command="{Binding ToggleServerCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StartStopButtonIcon}" Margin="0,0,8,0" FontSize="14" />
                                <TextBlock Text="{Binding StartStopButtonText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT TABS -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,12,16,12">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="16,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: DASHBOARD -->
                <TabItem Header="{Binding Loc[TabDashboard]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <!-- UPDATE AVAILABLE BANNER -->
                            <Border Style="{StaticResource CardStyle}"
                                    Background="#1A334D"
                                    BorderBrush="#2196F3"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsUpdateAvailable, Converter={x:Static models:ObjectToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                                <Grid>
                                    <!-- State 1: When NOT updating -->
                                    <Grid Visibility="{Binding IsUpdating, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🚀 " FontSize="14" />
                                                <TextBlock Text="{Binding Loc[UpdateAvailableTitle]}" FontWeight="Bold" FontSize="14" Foreground="#90CAF9" />
                                                <TextBlock Text="{Binding UpdateVersionText, StringFormat=' ({0})'}" FontWeight="Bold" FontSize="14" Foreground="White" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Loc[UpdateAvailableDesc]}" Foreground="#E3F2FD" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding Loc[UpdateNow]}" Command="{Binding ApplyUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                            <Button Content="{Binding Loc[UpdateLater]}" Command="{Binding DismissUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- State 2: When actively downloading update -->
                                    <Grid Visibility="{Binding IsUpdating, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⏳ " FontSize="14" />
                                                <TextBlock Text="{Binding Loc[DownloadingUpdate]}" FontWeight="Bold" FontSize="14" Foreground="#90CAF9" />
                                                <TextBlock Text="{Binding UpdateProgress, StringFormat=' ({0}%)'}" FontWeight="Bold" FontSize="14" Foreground="#FFD54F" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Loc[PleaseWait]}" FontSize="12" Foreground="#90CAF9" VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar Grid.Row="1"
                                                     Value="{Binding UpdateProgress}"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Height="8"
                                                     Margin="0,10,0,0"
                                                     Background="#0F2840"
                                                     Foreground="#38BDF8"
                                                     BorderThickness="0" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- SCREENSHOT TOAST NOTIFICATION -->
                            <Border Background="#166534" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16"
                                    Visibility="{Binding ScreenshotNotification, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📸 " FontSize="15" />
                                        <TextBlock Text="{Binding ScreenshotNotification}" FontWeight="Bold" Foreground="#86EFAC" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding OpenRecordingsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Loc[OpenRecordings]}" Padding="10,5" FontSize="11" />
                                </Grid>
                            </Border>

                            <!-- PIN CODE PROMPT MODAL BANNER -->
                            <Border Style="{StaticResource CardStyle}"
                                    Background="#2E1C0C"
                                    BorderBrush="#E65100"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding ActivePinCode, Converter={x:Static models:ObjectToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Loc[PinRequestedTitle]}" FontWeight="Bold" FontSize="14" Foreground="#FFB74D" />
                                        <TextBlock Text="{Binding Loc[PinRequestedDesc]}" Foreground="#FFE082" FontSize="12" Margin="0,4,0,8" />
                                        <Border Background="#1A0E04" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left" BorderBrush="#FF9800" BorderThickness="1">
                                            <TextBlock Text="{Binding ActivePinCode}" FontSize="24" FontWeight="Bold" Foreground="#FFD54F" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding DismissPinCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Loc[PinDismiss]}" VerticalAlignment="Top" />
                                </Grid>
                            </Border>

                            <!-- QUICK 3-STEP AIRPLAY GUIDE -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Loc[AirPlayGuideTitle]}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Step 1 -->
                                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[Step1Title]}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Loc[Step1Desc]}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Step 2 -->
                                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[Step2Title]}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Loc[Step2Desc]}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Step 3 -->
                                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[Step3Title]}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding DisplayStep3Desc}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ACTIVE STREAM & DEVICE HUD -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- HUD Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[MetricsTitle]}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <Border Background="#1A3320" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[ActiveHud]}" FontSize="10" Foreground="#25D366" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Recording status badge if recording -->
                                        <Border Grid.Column="1" Background="#7F1D1D" CornerRadius="4" Padding="8,3"
                                                Visibility="{Binding IsRecording, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Loc[RecordingActive]}" FontSize="10" Foreground="#FCA5A5" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- HUD 4 Metric Cards -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Device Name -->
                                        <Border Grid.Column="0" Background="#1D1D1D" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[ConnectedDevice]}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DisplayClientName}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayClientIp}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Resolution -->
                                        <Border Grid.Column="1" Background="#1D1D1D" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[Resolution]}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Session.ActiveResolution}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Loc[HardwareAccelerated]}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Codec & FPS -->
                                        <Border Grid.Column="2" Background="#1D1D1D" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[Framerate]}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Session.ActiveCodec}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding DisplayTargetFps}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Duration -->
                                        <Border Grid.Column="3" Background="#1D1D1D" CornerRadius="6" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[StreamTime]}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FormattedDuration}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Loc[LiveSession]}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- HUD Interactive Quick Controls (Volume Slider & Mute) -->
                                    <Border Grid.Row="2" Background="#161E2E" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Mute toggle & volume label -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding ToggleMuteCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding IsMuted, Converter={x:Static models:BoolToMuteIconConverter.Instance}}" FontSize="13" />
                                                </Button>
                                                <TextBlock Text="{Binding Loc[VolumeLabel]}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding VolumeDisplay}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Center: Volume Slider -->
                                            <Slider Grid.Column="1" Value="{Binding AudioVolume}" Minimum="0" Maximum="1" Margin="16,0" VerticalAlignment="Center" />

                                            <!-- Right: Quick folder open & screenshot -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding CaptureScreenshotCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0">
                                                    <TextBlock Text="📸 Captura" FontSize="11" FontWeight="SemiBold" />
                                                </Button>
                                                <Button Command="{Binding OpenRecordingsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5">
                                                    <TextBlock Text="📂 Grabaciones" FontSize="11" FontWeight="SemiBold" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- STREAMING PRESET SELECTOR -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[PresetTitle]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Loc[PresetSubtitle]}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />

                                    <ComboBox ItemsSource="{Binding AvailablePresets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              Margin="0,0,0,10">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static models:PresetDisplayConverter.Instance}}" Foreground="White" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Border Background="#1C1C1C" CornerRadius="6" Padding="12">
                                        <TextBlock Text="{Binding PresetDescription}" Foreground="#C5C5C5" FontSize="12" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- DISCOVERY & BONJOUR STATUS & NETWORK DIAGNOSTIC -->
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc[BonjourTitle]}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding Loc[BonjourDesc]}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="🌐 " FontSize="12" />
                                            <TextBlock Text="{Binding Loc[LocalIpLabel], StringFormat='{}{0}: '}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding LocalNetworkInfo}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Network Diagnostic Assistant -->
                                        <Button Command="{Binding RunDiagnosticCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🩺 " FontSize="12" />
                                                <TextBlock Text="{Binding Loc[DiagnosticButton]}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Repair Bonjour -->
                                        <Button Command="{Binding FixBonjourCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Loc[RepairBonjour]}"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: SETTINGS -->
                <TabItem Header="{Binding Loc[TabSettings]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <!-- General Settings -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[GeneralSettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <TextBlock Text="{Binding Loc[LanguageLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Loc.SupportedLanguages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              Height="36"
                                              Margin="0,0,0,12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Flag}" Margin="0,0,6,0" FontSize="14" />
                                                    <TextBlock Text="{Binding NativeName}" Foreground="White" FontSize="12" />
                                                    <TextBlock Text="{Binding DisplayName, StringFormat=' ({0})'}" Foreground="#888888" FontSize="11" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="{Binding Loc[ServerNameLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                    <!-- Monitor Selector -->
                                    <TextBlock Text="{Binding Loc[TargetDisplayLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableDisplays}"
                                              SelectedItem="{Binding SelectedDisplay}"
                                              DisplayMemberPath="DisplayLabel"
                                              Margin="0,0,0,12" />

                                    <!-- Checkboxes -->
                                    <CheckBox Content="{Binding Loc[StartWithWindowsLabel]}" IsChecked="{Binding StartOnBoot}" Margin="0,0,0,6" />
                                    <CheckBox Content="{Binding Loc[StartMinimizedLabel]}" IsChecked="{Binding StartMinimized}" Margin="20,0,0,8" />
                                    <CheckBox Content="{Binding Loc[MinimizeToTrayLabel]}" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,0,8" />
                                    <CheckBox Content="{Binding Loc[AlwaysOnTopLabel]}" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,8" />
                                    <CheckBox Content="{Binding Loc[HotkeysLabel]}" IsChecked="{Binding EnableGlobalHotkeys}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Loc[HotkeysHelp]}" FontSize="11" Foreground="#94A3B8" Margin="24,2,0,8" TextWrapping="Wrap" />
                                    <CheckBox Content="{Binding Loc[AutoStartServerLabel]}" IsChecked="{Binding Settings.AutoStartServer}" Margin="0,0,0,8" />
                                    <CheckBox Content="{Binding Loc[InhibitSleepLabel]}" IsChecked="{Binding Settings.InhibitSleepAndScreensaver}" Margin="0,0,0,8" />
                                    <CheckBox Content="{Binding Loc[EnableBleLabel]}" IsChecked="{Binding Settings.EnableBluetoothBeacon}" Margin="0,0,0,4" />
                                </StackPanel>
                            </Border>

                            <!-- Personalization & Accent Theme Colors -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[AccentColorLabel]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#38BDF8" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#38BDF8">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#A855F7" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#A855F7">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#22C55E" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#22C55E">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#F59E0B" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#F59E0B">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#F43F5E" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#F43F5E">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <!-- Folder Locations & Actions -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding OpenRecordingsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                                            <TextBlock Text="📂 Carpeta de Grabaciones" />
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding CaptureScreenshotCommand}" Style="{StaticResource SecondaryButtonStyle}">
                                            <TextBlock Text="📸 Tomar Captura de Pantalla" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Video Settings -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[DisplayVideoSettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Loc[TargetWidthLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding Settings.DisplayWidth}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Loc[TargetHeightLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding Settings.DisplayHeight}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Loc[FramerateLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding Settings.TargetFps}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Loc[VideoSinkLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding Settings.VideoSink}" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="{Binding Loc[EnableH265Label]}" IsChecked="{Binding Settings.EnableH265}" Margin="0,0,0,8" />
                                    <CheckBox Content="{Binding Loc[ForceFullscreenLabel]}" IsChecked="{Binding Settings.ForceFullscreen}" Margin="0,0,0,8" />
                                    <CheckBox Content="{Binding Loc[BorderlessLabel]}" IsChecked="{Binding Settings.BorderlessWindow}" Margin="0,0,0,4" />
                                </StackPanel>
                            </Border>

                            <!-- Audio Settings -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[AudioSettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <CheckBox Content="{Binding Loc[EnableAudioLabel]}" IsChecked="{Binding Settings.EnableAudio}" Margin="0,0,0,10" />

                                    <!-- Audio Volume Slider -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Loc[VolumeLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding VolumeDisplay, StringFormat=': {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0" />
                                            </StackPanel>
                                            <Slider Value="{Binding AudioVolume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding ToggleMuteCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IsMuted, Converter={x:Static models:BoolToMuteIconConverter.Instance}}" Margin="0,0,6,0" FontSize="13" />
                                                <TextBlock Text="{Binding MuteButtonText}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding Loc[AudioDelayLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.AudioDelayMs}" Margin="0,0,0,12" />

                                    <TextBlock Text="{Binding Loc[AudioSinkLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.AudioSink}" Margin="0,0,0,4" />
                                </StackPanel>
                            </Border>

                            <!-- Security & Pairing -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[SecuritySettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <CheckBox Content="{Binding Loc[RequirePinLabel]}" IsChecked="{Binding Settings.RequirePin}" Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding Loc[FixedPinLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.FixedPin}" MaxLength="4" Margin="0,0,0,12" />

                                    <TextBlock Text="{Binding Loc[PasswordLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.Password}" Margin="0,0,0,4" />
                                </StackPanel>
                            </Border>

                            <!-- Save Settings Button -->
                            <Button Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{Binding Loc[SaveSettings]}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,24" />

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: LOGS -->
                <TabItem Header="{Binding Loc[TabLogs]}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Logs Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding Logs.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Loc[LogsFilterTooltip]}"
                                     Height="34"
                                     Margin="0,0,10,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding Logs.CopyCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Loc[LogsCopy]}"
                                        Margin="0,0,6,0" />
                                <Button Command="{Binding Logs.ClearCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Loc[LogsClear]}" />
                            </StackPanel>
                        </Grid>

                        <!-- Logs List -->
                        <Border Grid.Row="1" Background="#111111" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                            <ListView ItemsSource="{Binding Logs.FilteredLogs}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Foreground="White"
                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                       FontSize="12">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" Foreground="#777777" />
                                            <Border Grid.Column="1" Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4: ABOUT -->
                <TabItem Header="{Binding Loc[TabAbout]}">
                    <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="UxPlay Desktop for Windows" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Loc[AboutSubtitle]}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,16" />

                            <TextBlock Text="{Binding Loc[AboutDesc]}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <TextBlock Text="{Binding Loc[AboutArchTitle]}" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Loc[AboutBullet1]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Loc[AboutBullet2]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Loc[AboutBullet3]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Loc[AboutBullet4]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="{Binding Loc[AboutAuthor]}" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                            <TextBlock Margin="0,0,0,4">
                                <Run Text="GitHub: " Foreground="{StaticResource TextSecondaryBrush}" />
                                <Hyperlink NavigateUri="https://github.com/jorjanion/uxplay-desktop"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Cursor="Hand">
                                    https://github.com/jorjanion/uxplay-desktop
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="License: GNU General Public License v3.0 (GPL-3.0)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>

            <!-- FOOTER BAR -->
            <Border Grid.Row="2" Background="#1D1D1D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusDescription}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="{Binding AppVersionDisplay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- VIEW 2: COMPACT MINI-WIDGET VIEW (When IsCompactMode is TRUE)   -->
        <!-- ============================================================== -->
        <Border Visibility="{Binding IsCompactMode, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}"
                Background="#181818" Padding="16,12">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status Indicator & Device -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📺" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
                            <TextBlock Text="{Binding DisplayClientName}" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                        </StackPanel>
                        <TextBlock Text="{Binding FormattedDuration}" FontSize="11" Foreground="#94A3B8" Margin="14,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Quick Actions & Volume Slider -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Quick Record -->
                    <Button Command="{Binding ToggleRecordingCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="{Binding Loc[RecordingTitle]}"
                            Margin="0,0,6,0"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="{Binding IsRecording, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />
                            <TextBlock Text="🎥" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Quick Screenshot -->
                    <Button Command="{Binding CaptureScreenshotCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Captura de pantalla"
                            Margin="0,0,8,0"
                            Padding="8,6">
                        <TextBlock Text="📸" FontSize="12" />
                    </Button>

                    <!-- Mute Toggle -->
                    <Button Command="{Binding ToggleMuteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            Padding="6,6"
                            ToolTip="{Binding Loc[MuteButton]}">
                        <TextBlock Text="{Binding IsMuted, Converter={x:Static models:BoolToMuteIconConverter.Instance}}" FontSize="12" />
                    </Button>

                    <!-- Volume Slider -->
                    <Slider Value="{Binding AudioVolume}" Minimum="0" Maximum="1" Width="80" VerticalAlignment="Center" ToolTip="{Binding VolumeDisplay}" />
                </StackPanel>

                <!-- Right: Server Start/Stop & Restore Normal View -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleServerCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,6,0"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StartStopButtonIcon}" Margin="0,0,6,0" FontSize="12" />
                            <TextBlock Text="{Binding StartStopButtonText}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Restore Full Normal View Button -->
                    <Button Command="{Binding ToggleCompactModeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="{Binding Loc[RestoreNormalMode]}"
                            Padding="8,7">
                        <TextBlock Text="🗖" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- VIEW 3: MODAL NETWORK DIAGNOSTIC DIALOG OVERLAY                -->
        <!-- ============================================================== -->
        <Grid Visibility="{Binding ShowDiagnosticDialog, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}"
              Background="#CC0B0F19"
              Panel.ZIndex="1000">
            <Border Background="#1E293B"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="640"
                    MaxHeight="520"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc[DiagnosticTitle]}" FontSize="16" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Inspección automática de mDNS, adaptadores y puertos AirPlay" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseDiagnosticCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Content="✕" />
                    </Grid>

                    <!-- Modal Body / Diagnostic Results List -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[DiagnosticRunning]}"
                                           Foreground="#38BDF8"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding IsRunningDiagnostic, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}"
                                           Margin="0,10"
                                           HorizontalAlignment="Center" />

                                <ItemsControl ItemsSource="{Binding DiagnosticReport.Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Severity, Converter={x:Static models:SeverityToIconConverter.Instance}}" FontSize="16" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="13" />
                                                            <Border Background="#334155" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#94A3B8" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Message}" Foreground="#E2E8F0" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Recommendation, StringFormat='💡 {0}'}"
                                                                   Foreground="#FCD34D"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding Recommendation, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Modal Footer -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding FixBonjourCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="14,8">
                            <TextBlock Text="🛠️ Reparar Red, Bonjour y Firewall" FontWeight="SemiBold" />
                        </Button>
                        <Button Grid.Column="1" Command="{Binding CloseDiagnosticCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Cerrar" Padding="16,8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
