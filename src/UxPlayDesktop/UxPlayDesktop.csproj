<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\resources\newicon.ico</ApplicationIcon>
    <Version>1.1.5</Version>
    <AssemblyVersion>1.1.5.0</AssemblyVersion>
    <FileVersion>1.1.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\resources\newicon.ico" Link="resources\newicon.ico" />
    <None Include="..\..\resources\newicon.ico" Link="resources\newicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
